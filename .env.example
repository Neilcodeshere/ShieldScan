# All keys are optional. Without them each feature falls back to sample data
# or a fixed message. Copy to .env.local and fill in what you have.

# Breach lookup (BreachDirectory on RapidAPI)
RAPIDAPI_KEY=
RAPIDAPI_HOST=

# Breach explanations and the assistant chat
GROQ_API_KEY=

# Phishing URL check
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Alert routes
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
